includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Livello 4: type coverage utile (errori di tipo, chiamate a metodi
    # inesistenti, ecc.) senza il rumore dei livelli stretti (8-9) che
    # richiederebbero annotazioni estese su un codebase esistente.
    level: 4

    excludePaths:
        - app/Console/Commands/PopulateDemoData.php # fixture demo, tolleranza volutamente bassa

    # La baseline (145+ entry, in gran parte model senza @property, vedi
    # CLAUDE.md H8) non riproduce esattamente lo stesso set di errori tra
    # dev locale e CI: piccole differenze di patch PHP/piattaforma bastano
    # a far apparire/sparire singoli property.notFound. Bloccare la build
    # su "baseline entry non trovata" quando il codice non è cambiato è
    # rumore, non un segnale utile — coerente con l'approccio "baseline =
    # debito accettato" del progetto.
    reportUnmatchedIgnoredErrors: false

    # I cast dei model (es. 'datetime') dichiarano un tipo PHPDoc certo
    # (Carbon non-null) che può divergere dal dato reale (colonna
    # nullable). treatPhpDocTypesAsCertain:true genera falsi positivi
    # ("nullsafe su tipo mai null", "instanceof sempre falso") proprio
    # sui cast dei model — suggerimento diretto del messaggio d'errore di
    # PHPStan stesso.
    treatPhpDocTypesAsCertain: false

    # Su CI (non riprodotto in locale — stessa larastan/phpstan version da
    # composer.lock, causa non trovata) alcuni cast 'datetime' su colonne
    # nullable vengono letti come string invece di Carbon|null, facendo
    # scattare "Cannot call method X() on string" dove il codice chiama
    # legittimamente metodi Carbon dopo un guard di nullità. Stesso pattern
    # in tutti i casi, elencato per file piuttosto che nella baseline
    # generata perché non riproducibile localmente per rigenerarla.
    ignoreErrors:
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 1
            path: app/Console/Commands/CheckAnnualAccountVerification.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 1
            path: app/Http/Controllers/Auth/AnnualAccountVerificationController.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 1
            path: app/Http/Controllers/GestioneController.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 2
            path: app/Notifications/DigestGestoreNotification.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 2
            path: app/Notifications/SlaViolazioneNotification.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 2
            path: app/Notifications/SlaWarningNotification.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 1
            path: app/Services/SegnalazioneWorkflowService.php
        -
            message: '#^Cannot call method \w+\(\) on string\.$#'
            identifier: method.nonObject
            count: 2
            path: app/Services/SlaService.php
