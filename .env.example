# Porte host esposte da nginx (default 80/443; usa ≥1024 su rootless Podman)
HTTP_PORT=80
HTTPS_PORT=443

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_VERSION=dev

# Il nome ente, logo, colori e altri parametri applicativi si configurano
# dall'interfaccia admin (Admin → Impostazioni), non da questo file.

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MariaDB container)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=segnalazioni
DB_USERNAME=segnalazioni
DB_PASSWORD=segnalazioni_secret
DB_ROOT_PASSWORD=root_secret

# Cache & Sessioni (Redis container)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

# Email — in sviluppo usa Mailpit (http://localhost:8025)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@comune.montesilvano.pe.it"
MAIL_FROM_NAME="ProntoPA"

# PEC (solo produzione)
PEC_HOST=mbox.cert.legalmail.it
PEC_PORT=465
PEC_USERNAME=
PEC_PASSWORD=
PEC_ENCRYPTION=ssl

# Nominatim (geocoding — solo infrastruttura, non endpoint modificabile da UI)
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Le coordinate e zoom default della mappa si configurano in Admin → Impostazioni
# (chiavi: osm_lat, osm_lng, osm_zoom)

# Webhook outbound → sito web Comune (URL e secret configurabili anche da Admin → Impostazioni)
WEBHOOK_CITTADINI_URL=
WEBHOOK_CITTADINI_SECRET=

# Scansione antimalware allegati (richiede profilo Docker `security`,
# vedi docker-compose.yml) + toggle Admin → Impostazioni → antivirus_enabled.
# Default già corretti per il compose: da cambiare solo con un'istanza ClamAV esterna.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Sanctum API (token per sito Comune)
SANCTUM_STATEFUL_DOMAINS=localhost

# Sessione
SESSION_LIFETIME=480
SESSION_COOKIE=prontoPA_session

# Error tracking (Sentry / Glitchtip self-hosted, stesso protocollo).
# Vuoto = disattivato, nessun errore lascia l'ente. environment/release
# usano APP_ENV/APP_VERSION di default, non serve impostarli qui.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ── Active Directory (login dipendenti) ─────────────────────────────────────
# Sviluppo locale senza AD: LDAP_HOST=mock → utenti simulati (password =
# username): mock.admin, mock.supervisore, mock.gestore, mock.operaio, mock.urp,
# mock.segnalatore, mock.nessungruppo. MAI in produzione (l'app non parte).
# Vuoto = nessun login dipendenti (solo ditte e account locali legacy).
LDAP_HOST=mock
LDAP_PORT=389
LDAP_BASE_DN=DC=ente,DC=local
# %s = username digitato. OBBLIGATORIO in formato UPN (%s@ente.local) o
# DOMINIO\%s: AD rifiuta il bind col solo username ("%s" → nessuno entra).
# Con l'UPN i dipendenti possono scrivere anche m.rossi@ente.local.
LDAP_USER_DN_TEMPLATE=%s@ente.local
LDAP_STARTTLS=false
# true ammesso solo in sviluppo (certificato AD self-signed)
LDAP_TLS_SKIP_VERIFY=false
LDAP_TIMEOUT=5
# Verifica rapida: docker compose exec php php artisan ldap:prova <username>
