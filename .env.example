# Porte host esposte da nginx (default 80/443; usa ≥1024 su rootless Podman)
HTTP_PORT=80
HTTPS_PORT=443

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_VERSION=dev

# Il nome ente, logo, colori e altri parametri applicativi si configurano
# dall'interfaccia admin (Admin → Impostazioni), non da questo file.

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MariaDB container)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=segnalazioni
DB_USERNAME=segnalazioni
DB_PASSWORD=segnalazioni_secret
DB_ROOT_PASSWORD=root_secret

# Cache & Sessioni (Redis container)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

# Email — tipo trasporto e mailer (obbligatorio per bootstrap)
# Host/port/credenziali SMTP configurabili da UI: Admin → Impostazioni → Email / SMTP
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null

# MAIL_FROM_ADDRESS e MAIL_FROM_NAME si configurano in Admin → Impostazioni
# (chiavi: mail_from_address, mail_from_name)

# PEC e SMTP server → configurabili da Admin → Impostazioni
# (chiavi: pec_host, pec_port, pec_username, pec_password, pec_encryption)
# (chiavi: smtp_host, smtp_port, smtp_username, smtp_password, smtp_encryption)

# Nominatim URL → configurabile da Admin → Impostazioni (chiave: osm_nominatim_url)
# Le coordinate e zoom della mappa → Admin → Impostazioni (chiavi: osm_lat, osm_lng, osm_zoom)

# Webhook outbound → configurabile da Admin → Impostazioni
# (chiavi: webhook_cittadini_url, webhook_cittadini_secret)

# Sanctum API (token per sito Comune)
SANCTUM_STATEFUL_DOMAINS=localhost

# Sessione
SESSION_LIFETIME=480
SESSION_COOKIE=prontoPA_session

# Utente admin iniziale — usato SOLO da AdminUserSeeder (sviluppo/CI).
# In produzione usa il wizard di setup: http://localhost/setup
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME="Amministratore"
